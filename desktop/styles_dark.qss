/* Obsidian — dark */

* {
    font-family: "Segoe UI", "Segoe UI Variable", system-ui, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #090a0d;
}

QWidget {
    background-color: transparent;
    color: #e2e4e9;
}

QFrame#Shell {
    background-color: #090a0d;
}

QFrame#Sidebar {
    background-color: #0f1116;
    border-right: 1px solid #1e222c;
    border-radius: 0;
}

QFrame#Content {
    background-color: #090a0d;
}

QFrame#TopBar {
    background-color: #0f1116;
    border: 1px solid #1e222c;
    border-radius: 14px;
}

QFrame#AccentLine {
    background-color: #c9a227;
    border: none;
    max-height: 2px;
    min-height: 2px;
}

QFrame#Card {
    background-color: #12151c;
    border: 1px solid #1e222c;
    border-radius: 14px;
}

QLabel#BrandMark {
    font-size: 22px;
    font-weight: 700;
    color: #e2e4e9;
    letter-spacing: -0.5px;
}

QLabel#BrandTag {
    font-size: 11px;
    color: #6b7280;
    font-weight: 400;
}

QLabel#HeaderTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e2e4e9;
    padding-right: 12px;
}

QLabel#CardTitle {
    font-size: 11px;
    font-weight: 600;
    color: #6b7280;
    text-transform: none;
    padding: 0;
    margin: 0;
}

QLabel#FieldLabel {
    font-size: 12px;
    color: #6b7280;
    font-weight: 500;
}

QLabel#StatusText {
    font-size: 12px;
    color: #9ca3af;
    font-weight: 400;
}

QLabel#StatusDot {
    font-size: 8px;
    color: #4b5563;
    padding: 0;
    margin: 0;
    min-width: 10px;
    max-width: 10px;
}

QLabel#StatusDot[state="ok"] { color: #6b9b7a; }
QLabel#StatusDot[state="warn"] { color: #a68b5b; }
QLabel#StatusDot[state="bad"] { color: #9b6b6b; }
QLabel#StatusDot[state="active"] { color: #c9a227; }
QLabel#StatusDot[state="idle"] { color: #4b5563; }

QLabel#ValueText {
    font-size: 14px;
    color: #e2e4e9;
    font-weight: 500;
}

QPushButton#NavButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    text-align: left;
    color: #6b7280;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background-color: #1a1e28;
    color: #9ca3af;
}

QPushButton#NavButton:checked {
    background-color: #1a1e28;
    color: #e2e4e9;
    border-left: 3px solid #c9a227;
    padding-left: 13px;
}

QPushButton#ThemeToggle {
    background-color: #1a1e28;
    border: 1px solid #2a3040;
    border-radius: 10px;
    padding: 8px 14px;
    color: #9ca3af;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#ThemeToggle:hover {
    background-color: #222733;
    color: #e2e4e9;
}

QPushButton {
    background-color: #1a1e28;
    border: 1px solid #2a3040;
    border-radius: 10px;
    padding: 9px 18px;
    color: #e2e4e9;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #222733;
}

QPushButton:pressed {
    background-color: #161a22;
}

QPushButton:disabled {
    color: #4b5563;
    background-color: #12151c;
}

QPushButton#PrimaryButton {
    background-color: #c9a227;
    border: 1px solid #a88620;
    color: #0a0c10;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #dbb42e;
    border-color: #c9a227;
}

QPushButton#AccentButton {
    background-color: transparent;
    border: 1px solid #2a3040;
    color: #e2e4e9;
}

QPushButton#AccentButton:hover {
    border-color: #3d4558;
    background-color: #1a1e28;
}

QPushButton#DangerButton {
    background-color: transparent;
    border: 1px solid #3d2a2a;
    color: #c9a0a0;
}

QPushButton#DangerButton:hover {
    background-color: #1a1414;
    border-color: #5c3d3d;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0c0e14;
    border: 1px solid #252a36;
    border-radius: 10px;
    padding: 10px 12px;
    color: #e2e4e9;
    selection-background-color: #3d4558;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3d4558;
    background-color: #0f1116;
}

QCheckBox {
    spacing: 10px;
    color: #9ca3af;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #3d4558;
    background: #0c0e14;
}

QCheckBox::indicator:checked {
    background: #c9a227;
    border-color: #a88620;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #2a3040;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QTextEdit#LogView,
QPlainTextEdit#LogView {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    background-color: #0c0e14;
    border: 1px solid #1e222c;
    border-radius: 10px;
    color: #9ca3af;
    padding: 4px;
}

QMessageBox {
    background-color: #12151c;
}
